{
  "name": "claude-cache-keepalive",
  "version": "0.1.0",
  "description": "给 Claude Code 桌面版会话保活 5 分钟提示缓存的 macOS 桌面应用",
  "private": true,
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "cc-peer": "1.6.8"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "44.7.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
